.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
.claude/
# Secrets / site-specific — never commit
config/llm_api.toml
**/llm_api.toml
# Site-specific cluster operating guide — has internal hostnames + account
# conventions. The generic template (cluster_agent_guide.template.md) is
# committed; copy it to lme_cluster_agent_guide.md and fill in locally.
config/lme_cluster_agent_guide.md
config/*_cluster_agent_guide.md
!config/cluster_agent_guide.template.md
/runs/
# Regenerable calibration/geometry PNGs+npz — removed from the tree in the
# 2026-06-19 result-register cleanup (recover from archive/pre-refactor-2026-06-19).
/results/
# Debug scratch served-tree junk — never commit into the Pages site again.
docs/_*debug/
docs/_breast_geom_debug/
docs/_fov_eval/
docs/_restage_verify/
docs/_mayo_figure_fix/
docs/_showcase_debug/
docs/_n2i_smoke/
docs/_n2i_onboard/
docs/_reg_test/
docs/_recorder_smoke/
# Static baseline PNG dir — archived out of the served tree (numbers live in the board).
docs/leaderboards/baseline_*/
# /data/<challenge>/ holds large staged HDF5 datasets — never committed.
# But data/*.py + data/*.md are the fetch scripts and ARE committed.
/data/*
!/data/*.py
!/data/*.md
/out/
# docs/runs/ is the dashboard data and IS committed.
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
papers/
# Wiley/AAPM LaTeX template asset — re-download with the curl command in
# paper_CTautoresearch.md §2 rather than redistributing it on the public repo.
paper/*.zip
paper/Optimal-Design-layout/

.env
llm_api.toml

# Cross-agent hand-off notes — ephemeral, regenerated per session.
hand-off.md

# large per-iter artifacts — never commit (GitHub 100MB limit)
*.npz
*.pt
model_ckpt.pt
recon_raw.npz
*.bak

# Submission packages are build artifacts (regenerate: scripts/make_submission.py)
paper/build/
